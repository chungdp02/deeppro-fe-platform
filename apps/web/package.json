{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node tests/verify.cjs",
    "test:verify": "node tests/verify.cjs",
    "test:visual": "node tests/visual.cjs",
    "test:perf": "node tests/run-lighthouse.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@workspace/ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "playwright": "^1.64.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
