    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "i18next": "^26.7.1",
    "lucide-react": "^1.68.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "playwright": "^1.64.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
